# Environment overrides for CoC Donation Bot.
# The bot does not load this file automatically — export the ones you need:
#   export ADB_DEVICE=127.0.0.1:5555
# Or copy values into systemd/coc-donation-bot.service Environment= lines.

# ADB serial from `adb devices` (Waydroid is often 127.0.0.1:5555 or a LAN IP).
ADB_DEVICE=127.0.0.1:5555

# Alternate path to calibrated.yaml (default: data/calibrated.yaml).
# COC_BOT_CONFIG=/home/you/Projects/coc-donation-bot/data/calibrated.yaml

# Set to 1 only if screencap resolution differs from `adb shell wm size` and taps miss.
# COC_BOT_SCALE_TAPS=1
