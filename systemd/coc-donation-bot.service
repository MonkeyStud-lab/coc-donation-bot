[Unit]
Description=CoC Donation Bot (Waydroid ADB automation)
After=network-online.target waydroid-container.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/coc-donation-bot
ExecStart=%h/Projects/coc-donation-bot/.venv/bin/python -m coc_bot.main
Restart=on-failure
RestartSec=15
Environment=ADB_DEVICE=192.168.240.112:5555
Environment=COC_BOT_CONFIG=%h/Projects/coc-donation-bot/data/calibrated.yaml
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
